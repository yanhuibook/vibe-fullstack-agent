# DeepSeek OpenAI-compatible API
VIBE_BASE_URL=https://api.deepseek.com
VIBE_MODEL=deepseek-flash
VIBE_API_KEY=replace-with-your-deepseek-api-key

# Per-call output limit (tokens); valid range 1024..65536
VIBE_MAX_OUTPUT_TOKENS=32000

# Set disabled to avoid default reasoning-token overhead; use enabled if desired
VIBE_THINKING=disabled
